{
  "manifest_version": 3,
  "name": "ActivityPub Browser Extension",
  "description": "Enable ActivityPub interactions in the browser.",
  "version": "0.0.0",
  "action": {
    "default_title": "ActivityPub"
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
